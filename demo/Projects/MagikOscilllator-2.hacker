use Hacker::Magik::SquareOscillator;

my $synth = virtual(sub {
	my $offset = shift;

	my $a = Hacker::Synth::Triangle->generate($offset*7)/10.0;
	my ($x, $y) = Hacker::Magik::SquareOscillator->calc($a);
	
	return [Hacker::Synth::Saw->generate(int 100*$x), Hacker::Synth::Triangle->generate(int 240*$y)];
});


my (@c1, @c2) = ();
for ($synth->sig(0, 30)) {
	push @c1, $_->[0];
	push @c2, $_->[1];
}

my (@c3, @c4) = ();
for ($synth->sig(-5)) {
	push @c3, $_->[0];
	push @c4, $_->[1];
}


my @m = mix(\@c1, \@c2);
my @m2 = mix(\@c3, \@c4);

(mix(
	[(seq(\@m, 61, '-1,.,.,.,-24,.,.,.,25,.,.,.,30'))x8],
	[(seq(\@m, 104, '#,.,0,.,3,.,.,.,-10,.,.,.,14'))x8],
	[(seq(\@m2, 118, '.,2,-5,.,7,.,.,.,4,.,.,.,2'))x8],
	[(seq(\@m2, 92, '14,12,.,.,40,.,13,.,,.,2,.,.,.'))x8],
))x4;
