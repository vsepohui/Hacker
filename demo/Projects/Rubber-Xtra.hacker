use Math::Trig qw(asin acos);

my ($a, $b, $c) = (7, 2, sqrt(7*7+2*2));

my @s1 = virtual (sub {
	my $offset = shift;

	my $x;
	
	my $alpha;
	if ($a > $b) {
		$x = $b / $a;
		$alpha = asin($b / $c);

		$c = acos($alpha / 2.0) * $b;
		$a = sqrt($c*$c - $b*$b);
	} else {
		$x = $b / $a;
		$alpha = asin($a / $c);

		$c = acos($alpha / 2.0) * $a;
		$b = sqrt($c*$c - $a*$a);
	}
	
	if ($c < 10) {
		$a *= 10;
		$b *= 10;
	}
	
	$c = sqrt($a*$a+$b*$b);
	

	return sin($alpha*$offset);
})->sig (0, 1);

my @s2 = virtual (sub {
	my $offset = shift;

	my $x;
	
	my $alpha;
	if ($a > $b) {
		$x = $b / $a;
		$alpha = asin($b / $c);

		$c = acos($alpha / 2.0) * $b;
		$a = sqrt($c*$c - $b*$b);
	} else {
		$x = $b / $a;
		$alpha = asin($a / $c);

		$c = acos($alpha / 2.0) * $a;
		$b = sqrt($c*$c - $a*$a);
	}
	
	if ($c < 10) {
		$a *= 10;
		$b *= 10;
	}
	
	$c = sqrt($a*$a+$b*$b);
	

	return cos($alpha*$offset);
})->sig (0, 1);



my (@c1, @c2);
for (0..420) {
	push @c1, sine int ($s1[$_]*100) % 32, 0.4;
	push @c2, sine int ($s2[$_]*100) % 32, 0.8;
}

my $kick  = sample('../Samples/extra/kick_029.flac');
my $snare = sample('../Samples/extra/snare_028.flac');
my $hat   = sample('../Samples/extra/hat_003.flac');

my @c3 = seq([$kick->play(-24)],  150, '0,.,.,.,.,0,.,.,0,.,.,.,.,0,.,.'); # Kick
my @c4 = seq([$kick->play(-36)],  150, '0,.,.,.,.,0,.,.,0,.,.,.,.,0,.,.'); # Sub kick
my @c5 = seq([$snare->play(-12)], 150, '.,.,0,.,.,.,0,.,.,.,0,.,.,.,0,.'); # Snare
my @c6 = seq([$hat->play(-24)],   100, '0,.,0,.,0,.,0,.,0,.,0,.,0,.,0,.'); # Hat


my @drumline = (mix(\@c4, \@c5, \@c6))x50;




mix(\@c1, \@c2, \@c3, \@drumline);
