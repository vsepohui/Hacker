use Hacker::Magik::SquareOscillator;

my $len = 2;

my @s1 = e 6,17, 100*$len, sub{sin ($_[0]*$_[1])};


my $n = 0;

my $synth = virtual(sub {
	my $offset = shift;
	
	my $a = Hacker::Synth::Triangle->generate($s1[$n]*$offset);
	my ($x, $y) = Hacker::Magik::SquareOscillator->calc($a*180);
	$n ++;
	return [Hacker::Synth::Sin->generate(int 100*$x), Hacker::Synth::Sin->generate(int 240*$y)];
});

my $o = sample('../Samples/organ1-yamaha.flac');



my (@c1, @c2);
for (0..($len*100-1)) {
	my $g = $synth->generate($_);
	#push @c1, crop $o->play(int ($g->[0]*36)), int (($g->[1] + 1) * 4) / 8;
	push @c2, crop $o->play(int ($g->[0]*36)-12), int (($g->[1] + 1) * 4) / 8;
	#push @c2, $_->[1];
}

my $kick  = sample('../Samples/extra/kick_029.flac');
my $snare = sample('../Samples/extra/snare_028.flac');
my $hat   = sample('../Samples/extra/hat_003.flac');

my @c3 = seq([$kick->play(-24)],  120, '0,.,.,.,.,0,.,.,0,.,.,.,.,0,.,.'); # Kick
my @c4 = seq([$kick->play(-36)],  120, '0,.,.,.,.,0,.,.,0,.,.,.,.,0,.,.'); # Sub kick
my @c5 = seq([$snare->play(-12)], 120, '.,.,0,.,.,.,0,.,.,.,0,.,.,.,0,.'); # Snare

my @h = seq([$hat->play(-24)], 140, join ',', (('0', '.') x (8 * 20))); # Hat


my @drumline = (mix(\@c3,\@c4,\@c5,\@h))x20;

mix \@c2, \@drumline;

#[@h x 8];
