#!/usr/bin/perl

use 5.022;
use warnings;

use FindBin qw($Bin);
use lib "$Bin/../lib";

use Hacker;

my $usage = "Usage:\n\t$0 [--driver=...] [--help|-h] [--version|-v] [--input|-i=file.hacker] [--output|-o=file.pcm] [--exec|-e=code] [project-file.hacker] [-]";
my %args = process_command_line(qw/driver=s i|input=s o|output=s e|exec=s h|help v|version/, $usage);

if ($args{version}) {
	say "Hacker 0.3b";
	exit;
}

my @signal;

my $hacker = new Hacker(driver => $args{driver});

my $stdout = ($ARGV[-1] // '') eq '-';
my $stdin = ($ARGV[-2] // '') eq '-';

my $file = $args{input} // $ARGV[-1] // '';

if (my $code = $args{exec} || $stdin || !(-f $file)) {
	if ($stdin || !$code || $code eq '1') {
		$code = join '', <>;
	}
	
	$code = q[use Hacker;] . $code;
		
	# Execute
	@signal = eval $code; die $@ if $@;
} else {
	@signal = load($file);
}

if (my $file = $args{output}) {
	$hacker->render($file => @signal);
} elsif ($stdout) {
	$hacker->render('<STDOUT>' => @signal);
} else {
	$hacker->play(@signal);
}

1;
