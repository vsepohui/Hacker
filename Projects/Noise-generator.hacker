my @n = noise;

(mix(
	[seq(sample => [@n], '0,.,#,.,-12,0,.,0,#,.,48,.,.,3,.,.,44,52,54,70,.,-20,2')],
	[seq(sample => [@n], '-36,24,.,.,4,1,.,11,2,.,.,1,.,5,.,.,26,1,1,1,1,1,1')],
	[seq(sample => [@n],  join ',', map{int(rand()*40)-20} 1..40)],
	[seq(sample => [@n],  join ',', map{int(rand()*40)-20} 1..40)],
	[seq(sample => [@n],  join ',', map{int(rand()*40)-20} 1..40)],
)) x 10;
