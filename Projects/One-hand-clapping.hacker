use Hacker::Synth::Triangle;
use Hacker::Mixer;

my @seq = qw[0 4 5 0 4 5 0 4 5 7 7 7 16 12 9 16 12 9 16 12 9 7 7 7] x4;

my (@c1, @c2);

for (@seq) {
	push @c1, Hacker::Synth::Triangle->signal($_ - 1, 0.5);
	push @c2, Hacker::Synth::Triangle->signal($_ - 1 + 12, 0.5);
}

my $mixer = new Hacker::Mixer(channels => [\@c1, \@c2]);
$mixer->master;
