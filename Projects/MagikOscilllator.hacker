use Hacker::Magik::SquareOscillator;

my $synth = virtual(sub {
	my $offset = shift;

	my $a = Hacker::Synth::Triangle->generate($offset*10)/10;
	my ($x, $y) = Hacker::Magik::SquareOscillator->calc($a);
	return [Hacker::Synth::Sin->generate(int 100*$x), Hacker::Synth::Sin->generate(int 240*$y)];
});


my (@c1, @c2);
for ($synth->sig(0, 30)) {
	push @c1, $_->[0];
	push @c2, $_->[1];
}

my (@c3, @c4);
for ($synth->sig(5)) {
	push @c3, $_->[0];
	push @c4, $_->[1];
}


my @m = mix(\@c1, \@c2);
my @m2 = mix(\@c3, \@c4);

(chip mix(
	[(seq(\@m, 79, '-24,.,.,.,-12,.,.,.,-24,.,.,.,-12'))x8],
	[(seq(\@m, 134, '16,.,21,.,3,.,.,.,0,.,.,.,14'))x8],
	[(seq(\@m2, 140, '1,.,-5,.,7,.,.,.,5,.,.,.,2'))x8],
	[(seq(\@m2, 120, '0,#,-25,.,#,.,2,.,,.,.,.,25,.'))x8],
))x4;
